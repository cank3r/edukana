# PostgreSQL. Use a pooled URL at runtime and a direct/session-pooler URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Generate independent random values; never commit real secrets.
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
CERTIFICATE_SECRET="replace-with-a-different-random-secret"

# Private Supabase Storage. The service-role key is server-only.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-key"
SUPABASE_STORAGE_BUCKET="edukana"


# Local-only private storage for an isolated pilot (do not set in staging/production).
# LOCAL_STORAGE_ROOT="C:\\absolute\\private\\edukana-storage"
# LOCAL_STORAGE_SECRET="replace-with-a-random-secret-at-least-32-characters"
# APP_URL="http://127.0.0.1:3100"

# Correo transaccional (recuperación de contraseña). Sin estas variables el envío falla y queda en logs.
RESEND_API_KEY="replace-with-the-resend-api-key"
EMAIL_FROM="Edukana <no-responder@tu-dominio.com>"
# URL pública de la aplicación, usada en los enlaces de los correos.
APP_URL="https://tu-dominio.com"

# Opcionales. Valores por defecto: 5 fallos por correo, 20 por IP, sesión de 7 días.
# LOGIN_MAX_FAILURES_PER_EMAIL="5"
# LOGIN_MAX_FAILURES_PER_IP="20"
# SESSION_MAX_AGE_DAYS="7"
