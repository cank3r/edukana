{
  "name": "edukana",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/security.test.ts tests/permissions.test.ts tests/course-scope.test.ts tests/guardianship.test.ts tests/lms.test.ts tests/gradebook-calc.test.ts tests/schema.test.ts tests/ux.test.ts tests/announcements.test.ts tests/announcement-compose.test.ts tests/local-storage.test.ts tests/canonical-pilot.test.ts tests/canonical-pilot-runner.test.mjs",
    "test:auth": "tsx --test tests/security.test.ts",
    "test:integration": "node --require ./tests/integration/stub-server-only.cjs --import tsx --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:pilot:config": "node --test tests/canonical-pilot-runner.test.mjs",
    "test:pilot:preview": "playwright test --config=playwright.pilot.config.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "5.9.1",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "2.117.2",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.49.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "20.19.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "5.22.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
