// Edukana — esquema académico multiinstitución
// PostgreSQL / Supabase Free: toda entidad de negocio conserva institutionId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Institution {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  type               InstitutionType     @default(SCHOOL)
  logoUrl            String?
  domain             String?             @unique
  timezone           String              @default("America/Santo_Domingo")
  language           String              @default("es")
  brandColor         String?
  plan               Plan                @default(FREE)
  platformSubscription InstitutionSubscription?
  platformInvoices PlatformInvoice[]
  settings           Json                @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  users              User[]
  academicPeriods    AcademicPeriod[]
  courses            Course[]
  announcements      Announcement[]
  admissionLeads     AdmissionLead[]
  paymentConcepts    PaymentConcept[]
  events             CalendarEvent[]
  gradingPeriods     GradingPeriod[]
  gradeCategories    GradeCategory[]
  gradeItems         GradeItem[]
  gradeEntries       GradeEntry[]
  attendanceSessions AttendanceSession[]
  attendances        Attendance[]
  sections           CourseSection[]
  lessons            Lesson[]
  lessonProgress     LessonProgress[]
  questionBank       QuestionBankItem[]
  exams              Exam[]
  examAttempts       ExamAttempt[]
  scheduleSlots      ScheduleSlot[]
  assets             StorageAsset[]
  certificates       Certificate[]
  roleCapabilityOverrides RoleCapabilityOverride[]
  guardianships           Guardianship[]
  organizationalUnits     OrganizationalUnit[]
  unitMemberships         OrganizationalUnitMembership[]
  announcementRoleTargets AnnouncementRoleTarget[]
  announcementCourseTargets AnnouncementCourseTarget[]
  announcementUserTargets AnnouncementUserTarget[]
  announcementUnitTargets AnnouncementUnitTarget[]
  announcementRelatedCourses AnnouncementRelatedCourse[]
  announcementMentions    AnnouncementMention[]
  enrollments             Enrollment[]
  assignments             Assignment[]
  submissions             Submission[]
  examQuestions           ExamQuestion[]
  examAnswers             ExamAnswer[]
  submissionRevisions     SubmissionRevision[]
  gradeEntryRevisions     GradeEntryRevision[]
  programs                Program[]
  studentGroups           StudentGroup[]
  liveClasses             LiveClass[]
  payments                Payment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  courseOrders            CourseOrder[]
  coupons                 Coupon[]
  courseReviews           CourseReview[]

  @@map("institutions")
}

enum InstitutionType {
  SCHOOL
  UNIVERSITY
  INSTITUTE
  ACADEMY
  OTHER
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id                 String              @id @default(cuid())
  institutionId      String
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name               String
  email              String
  emailVerified      DateTime?
  password           String?
  avatarUrl          String?
  phone              String?
  role               Role                @default(STUDENT)
  status             UserStatus          @default(ACTIVE)
  sessionVersion     Int                 @default(0)
  identityId         String?
  identity           Identity?           @relation(fields: [identityId], references: [id])
  accounts           Account[]
  sessions           Session[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  taughtCourses      Course[]            @relation("TeacherCourses")
  enrollments        Enrollment[]
  submissions        Submission[]
  announcements      Announcement[]      @relation("AnnouncementAuthor")
  recordedAttendance AttendanceSession[] @relation("AttendanceRecorder")
  gradedEntries      GradeEntry[]        @relation("GradeRecorder")
  examAttempts       ExamAttempt[]
  scheduleSlots      ScheduleSlot[]      @relation("ScheduleTeacher")
  uploadedAssets     StorageAsset[]      @relation("AssetUploader")
  issuedCertificates Certificate[]       @relation("CertificateIssuer")
  updatedRoleCapabilities RoleCapabilityOverride[] @relation("RoleCapabilityOverrideUpdater")
  parentGuardianships     Guardianship[] @relation("GuardianshipParent")
  studentGuardianships    Guardianship[] @relation("GuardianshipStudent")
  createdGuardianships    Guardianship[] @relation("GuardianshipCreator")
  updatedGuardianships    Guardianship[] @relation("GuardianshipUpdater")
  organizationalMemberships OrganizationalUnitMembership[]
  announcementTargets     AnnouncementUserTarget[]
  announcementMentions    AnnouncementMention[]
  passwordResetTokens     PasswordResetToken[]
  paymentConcepts         PaymentConcept[] @relation("PaymentStudent")
  gradeEntryRevisions     GradeEntryRevision[] @relation("GradeRevisionActor")
  groupMemberships        StudentGroupMember[]
  createdLiveClasses      LiveClass[] @relation("LiveClassCreator")
  recordedPayments        Payment[] @relation("PaymentRecorder")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  courseOrders            CourseOrder[]
  courseReviews           CourseReview[]

  @@unique([institutionId, email])
  @@unique([institutionId, identityId])
  @@index([institutionId, role])
  @@index([identityId])
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AcademicPeriod {
  id              String           @id @default(cuid())
  institutionId   String
  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  courses         Course[]
  paymentConcepts PaymentConcept[]
  gradingPeriods  GradingPeriod[]

  @@index([institutionId, startDate])
  @@map("academic_periods")
}

model Course {
  id                  String              @id @default(cuid())
  institutionId       String
  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  periodId            String
  period              AcademicPeriod      @relation(fields: [periodId], references: [id])
  teacherId           String
  teacher             User                @relation("TeacherCourses", fields: [teacherId], references: [id])
  name                String
  code                String?
  description         String?
  schedule            Json?
  room                String?
  maxStudents         Int?
  completionThreshold Int                 @default(100)
  isPublished         Boolean             @default(true)
  archivedAt          DateTime?
  imageUrl            String?
  isPublic            Boolean             @default(false)
  priceCents          Int?
  currency            String              @default("DOP")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  enrollments         Enrollment[]
  assignments         Assignment[]
  modules             CourseModule[]
  sections            CourseSection[]
  lessons             Lesson[]
  attendanceSessions  AttendanceSession[]
  attendances         Attendance[]
  gradingPeriods      GradingPeriod[]
  gradeCategories     GradeCategory[]
  gradeItems          GradeItem[]
  questionBank        QuestionBankItem[]
  exams               Exam[]
  scheduleSlots       ScheduleSlot[]
  assets              StorageAsset[]
  certificates        Certificate[]
  announcementTargets AnnouncementCourseTarget[]
  programCourses      ProgramCourse[]
  groupCourses        StudentGroupCourse[]
  liveClasses         LiveClass[]
  orders              CourseOrder[]
  reviews             CourseReview[]
  relatedAnnouncements AnnouncementRelatedCourse[]

  @@unique([institutionId, code])
  @@index([institutionId, teacherId])
  @@map("courses")
}

// Compatibilidad con contenidos Alpha; las nuevas experiencias usan CourseSection > Lesson.
model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  content     String?  @db.Text
  fileUrls    Json?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("course_modules")
}

model CourseSection {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  order         Int         @default(0)
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lessons       Lesson[]

  @@unique([courseId, order])
  @@index([institutionId, courseId])
  @@map("course_sections")
}

model Lesson {
  id               String           @id @default(cuid())
  institutionId    String
  institution      Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId        String
  section          CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  content          String?          @db.Text
  /// Video de la lección además del texto: dirección ya normalizada por `src/lib/lesson-video.ts`.
  videoUrl         String?
  type             LessonType       @default(TEXT)
  order            Int              @default(0)
  estimatedMinutes Int              @default(10)
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assets           StorageAsset[]
  progress         LessonProgress[]

  @@unique([sectionId, order])
  @@index([institutionId, courseId])
  @@map("lessons")
}

enum LessonType {
  TEXT
  VIDEO
  DOCUMENT
  ACTIVITY
}

model Enrollment {
  id              String           @id @default(cuid())
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId       String
  student         User             @relation(fields: [studentId], references: [id])
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id])
  status          EnrollmentStatus @default(ACTIVE)
  finalGrade      Float?
  progressPercent Float            @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  withdrawnAt     DateTime?
  withdrawReason  String?
  attendances     Attendance[]
  submissions     Submission[]
  gradeEntries    GradeEntry[]
  lessonProgress  LessonProgress[]
  examAttempts    ExamAttempt[]
  certificates    Certificate[]

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([institutionId, courseId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  FAILED
}

model AttendanceSession {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date          DateTime     @db.Date
  title         String?
  recordedById  String
  recordedBy    User         @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  createdAt     DateTime     @default(now())
  records       Attendance[]

  @@unique([courseId, date])
  @@index([institutionId, date])
  @@map("attendance_sessions")
}

model Attendance {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessionId     String
  session       AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date          DateTime          @db.Date
  classSession  String?
  status        AttendanceStatus  @default(PRESENT)
  notes         String?
  recordedAt    DateTime          @default(now())

  @@unique([sessionId, enrollmentId])
  @@index([institutionId, courseId, date])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model GradingPeriod {
  id               String          @id @default(cuid())
  institutionId    String
  institution      Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicPeriodId String
  academicPeriod   AcademicPeriod  @relation(fields: [academicPeriodId], references: [id])
  name             String
  startDate        DateTime
  endDate          DateTime
  weight           Float           @default(100)
  isPublished      Boolean         @default(false)
  publishedAt      DateTime?
  categories       GradeCategory[]
  items            GradeItem[]

  @@unique([courseId, name])
  @@index([institutionId, courseId])
  @@map("grading_periods")
}

model GradeCategory {
  id              String        @id @default(cuid())
  institutionId   String
  institution     Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  gradingPeriodId String
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId], references: [id], onDelete: Cascade)
  name            String
  weight          Float
  dropLowest      Int           @default(0)
  items           GradeItem[]

  @@unique([gradingPeriodId, name])
  @@index([institutionId, courseId])
  @@map("grade_categories")
}

model GradeItem {
  id              String        @id @default(cuid())
  institutionId   String
  institution     Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  gradingPeriodId String
  gradingPeriod   GradingPeriod @relation(fields: [gradingPeriodId], references: [id], onDelete: Cascade)
  categoryId      String
  category        GradeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignmentId    String?       @unique
  assignment      Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  examId          String?       @unique
  exam            Exam?         @relation(fields: [examId], references: [id], onDelete: SetNull)
  title           String
  maxScore        Float         @default(100)
  weight          Float         @default(1)
  isPublished     Boolean       @default(false)
  dueDate         DateTime?
  entries         GradeEntry[]

  @@index([institutionId, courseId])
  @@map("grade_items")
}

model GradeEntry {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  gradeItemId   String
  gradeItem     GradeItem   @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  score         Float?
  feedback      String?     @db.Text
  isExcused     Boolean     @default(false)
  gradedById    String
  gradedBy      User        @relation("GradeRecorder", fields: [gradedById], references: [id])
  gradedAt      DateTime    @default(now())
  autoGraded    Boolean     @default(false)
  revisions     GradeEntryRevision[]

  @@unique([gradeItemId, enrollmentId])
  @@index([institutionId, enrollmentId])
  @@map("grade_entries")
}

model Assignment {
  id           String         @id @default(cuid())
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  description  String?        @db.Text
  instructions String?        @db.Text
  dueDate      DateTime?
  maxScore     Float          @default(100)
  type         AssignmentType @default(TASK)
  aiGenerated  Boolean        @default(false)
  isPublished  Boolean        @default(false)
  publishedAt  DateTime?
  allowLate    Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  submissions  Submission[]
  gradeItem    GradeItem?
  assets       StorageAsset[]

  @@index([courseId, dueDate])
  @@index([institutionId, courseId])
  @@map("assignments")
}

enum AssignmentType {
  TASK
  QUIZ
  EXAM
  PROJECT
}

model Submission {
  id           String           @id @default(cuid())
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id])
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  content      String?          @db.Text
  fileUrls     Json?
  score        Float?
  feedback     String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  assets       StorageAsset[]
  revisions    SubmissionRevision[]

  @@unique([assignmentId, studentId])
  @@index([institutionId, assignmentId])
  @@map("submissions")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

model QuestionBankItem {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type          QuestionType
  prompt        String         @db.Text
  options       Json?
  answerKey     String         @db.Text
  explanation   String?        @db.Text
  defaultPoints Float          @default(1)
  createdAt     DateTime       @default(now())
  examQuestions ExamQuestion[]
  answers       ExamAnswer[]

  @@index([institutionId, courseId, type])
  @@map("question_bank_items")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model Exam {
  id              String         @id @default(cuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  instructions    String?        @db.Text
  opensAt         DateTime?
  closesAt        DateTime?
  durationMinutes Int?
  maxAttempts     Int            @default(1)
  isPublished     Boolean        @default(false)
  showReview      Boolean        @default(true)
  passingPercent  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  questions       ExamQuestion[]
  attempts        ExamAttempt[]
  gradeItem       GradeItem?

  @@index([institutionId, courseId])
  @@map("exams")
}

model ExamQuestion {
  id         String           @id @default(cuid())
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examId     String
  exam       Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  bankItemId String
  bankItem   QuestionBankItem @relation(fields: [bankItemId], references: [id])
  order      Int
  points     Float
  snapshot   Json?

  @@unique([examId, bankItemId])
  @@unique([examId, order])
  @@index([institutionId, examId])
  @@map("exam_questions")
}

model ExamAttempt {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examId        String
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User          @relation(fields: [studentId], references: [id])
  attemptNumber Int
  status        AttemptStatus @default(IN_PROGRESS)
  score         Float?
  maxScore      Float?
  startedAt     DateTime      @default(now())
  expiresAt     DateTime?
  submittedAt   DateTime?
  answers       ExamAnswer[]

  @@unique([examId, studentId, attemptNumber])
  @@index([institutionId, examId])
  @@map("exam_attempts")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model ExamAnswer {
  id         String           @id @default(cuid())
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  attemptId  String
  attempt    ExamAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  bankItemId String
  bankItem   QuestionBankItem @relation(fields: [bankItemId], references: [id])
  response   String?          @db.Text
  isCorrect  Boolean?
  score      Float?
  feedback   String?          @db.Text

  @@unique([attemptId, bankItemId])
  @@index([institutionId, attemptId])
  @@map("exam_answers")
}

model ScheduleSlot {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User        @relation("ScheduleTeacher", fields: [teacherId], references: [id])
  weekday       Int
  startMinutes  Int
  endMinutes    Int
  classroom     String
  startsOn      DateTime?   @db.Date
  endsOn        DateTime?   @db.Date
  createdAt     DateTime    @default(now())

  @@index([institutionId, weekday, startMinutes])
  @@index([teacherId, weekday])
  @@map("schedule_slots")
}

enum AssetKind {
  DOCUMENT
  VIDEO
  IMAGE
  OTHER
}

enum AssetVisibility {
  COURSE
  PRIVATE
  INSTITUTION
}

model StorageAsset {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String?
  course        Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assignmentId  String?
  assignment    Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  submissionId  String?
  submission    Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  announcementId String?
  announcement  Announcement?   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  uploaderId    String
  uploader      User            @relation("AssetUploader", fields: [uploaderId], references: [id])
  bucket        String          @default("edukana")
  objectPath    String          @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  kind          AssetKind
  visibility    AssetVisibility @default(COURSE)
  checksum      String?
  confirmedAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([institutionId, courseId])
  @@index([institutionId, announcementId])
  @@map("storage_assets")
}

model LessonProgress {
  id                  String      @id @default(cuid())
  institutionId       String
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  enrollmentId        String
  enrollment          Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed           Boolean     @default(false)
  watchedSeconds      Int         @default(0)
  lastPositionSeconds Int         @default(0)
  updatedAt           DateTime    @updatedAt
  completedAt         DateTime?

  @@unique([enrollmentId, lessonId])
  @@index([institutionId, lessonId])
  @@map("lesson_progress")
}

model Certificate {
  id               String      @id @default(cuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollmentId     String
  enrollment       Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  issuedById       String
  issuedBy         User        @relation("CertificateIssuer", fields: [issuedById], references: [id])
  verificationCode String      @unique
  verificationHash String
  issuedAt         DateTime    @default(now())
  revokedAt        DateTime?
  metadata         Json        @default("{}")

  @@unique([enrollmentId, courseId])
  @@index([institutionId, issuedAt])
  @@map("certificates")
}

model AdmissionLead {
  id              String         @id @default(cuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String?
  programInterest String?
  stage           AdmissionStage @default(INTERESTED)
  documents       Json?
  notes           String?        @db.Text
  source          String?
  convertedUserId String?
  convertedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([institutionId, stage])
  @@map("admission_leads")
}

enum AdmissionStage {
  INTERESTED
  DOCUMENTS
  REVIEW
  ACCEPTED
  ENROLLED
  REJECTED
}

model PaymentConcept {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String?
  student       User?           @relation("PaymentStudent", fields: [studentId], references: [id])
  periodId      String?
  period        AcademicPeriod? @relation(fields: [periodId], references: [id])
  concept       String
  amount        Float
  amountCents   Int?
  currency      String          @default("DOP")
  dueDate       DateTime?
  paidAt        DateTime?
  status        PaymentStatus   @default(PENDING)
  notes         String?
  createdAt     DateTime        @default(now())
  payments      Payment[]

  @@index([institutionId, status])
  @@index([institutionId, studentId])
  @@map("payment_concepts")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

model Announcement {
  id                  String               @id @default(cuid())
  institutionId       String
  institution         Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  authorId            String
  author              User                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  title               String
  content             String               @db.Text
  externalUrl         String?
  audienceInstitution Boolean              @default(false)
  audience            AnnouncementAudience @default(ROLE)
  audienceId          String?
  isPinned            Boolean              @default(false)
  publishedAt         DateTime             @default(now())
  createdAt           DateTime             @default(now())
  roleTargets         AnnouncementRoleTarget[]
  courseTargets       AnnouncementCourseTarget[]
  userTargets         AnnouncementUserTarget[]
  unitTargets         AnnouncementUnitTarget[]
  relatedCourses      AnnouncementRelatedCourse[]
  mentions            AnnouncementMention[]
  assets              StorageAsset[]

  @@index([institutionId, publishedAt])
  @@map("announcements")
}

enum AnnouncementAudience {
  ALL
  COURSE
  ROLE
}

model OrganizationalUnit {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        OrganizationalUnit? @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      OrganizationalUnit[] @relation("UnitHierarchy")
  name          String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   OrganizationalUnitMembership[]
  targets       AnnouncementUnitTarget[]

  @@unique([institutionId, name])
  @@index([institutionId, parentId])
