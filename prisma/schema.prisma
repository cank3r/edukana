}

model OrganizationalUnitMembership {
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  unitId        String
  unit          OrganizationalUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@id([unitId, userId])
  @@index([institutionId, userId])
  @@map("organizational_unit_memberships")
}

model AnnouncementRoleTarget {
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  announcementId String
  announcement  Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
