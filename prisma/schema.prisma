}
model CalendarEvent {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  allDay        Boolean     @default(true)
