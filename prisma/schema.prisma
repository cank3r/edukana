enum GuardianshipRelationship {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  OTHER
}

enum GuardianshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Guardianship {
  id                   String                   @id @default(cuid())
  institutionId        String
  institution          Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentId             String
  parent               User                     @relation("GuardianshipParent", fields: [parentId], references: [id], onDelete: Cascade)
  studentId            String
  student              User                     @relation("GuardianshipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  relationship         GuardianshipRelationship
  status               GuardianshipStatus       @default(PENDING)
  canViewAcademics     Boolean                  @default(false)
  canViewAttendance    Boolean                  @default(false)
  canViewSchedule      Boolean                  @default(false)
  canViewAnnouncements Boolean                  @default(false)
  canViewFinance       Boolean                  @default(false)
  createdById          String
  createdBy            User                     @relation("GuardianshipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById          String
  updatedBy            User                     @relation("GuardianshipUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  version              Int                      @default(0)
  revokedAt            DateTime?

  @@unique([institutionId, parentId, studentId])
  @@index([institutionId, parentId, status])
  @@index([institutionId, studentId, status])
  @@map("guardianships")
}

model RoleCapabilityOverride {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role          Role
  capability    String
  enabled       Boolean
  updatedById   String
  updatedBy     User        @relation("RoleCapabilityOverrideUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, role, capability])
  @@index([institutionId, role])
  @@map("role_capability_overrides")
}

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String?
  userId        String?
  action        String
  entity        String
  entityId      String?
  changes       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([institutionId, createdAt])
  @@map("audit_logs")
}

// --- S1: seguridad e historia académica ---

model LoginAttempt {
  id        String   @id @default(cuid())
  emailHash String
  ipHash    String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model SubmissionRevision {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  content       String?     @db.Text
  assetIds      Json        @default("[]")
  fileUrls      Json?
  submittedAt   DateTime
  createdAt     DateTime    @default(now())

  @@index([institutionId, submissionId])
  @@map("submission_revisions")
}

model GradeEntryRevision {
  id               String      @id @default(cuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  gradeEntryId     String
  gradeEntry       GradeEntry  @relation(fields: [gradeEntryId], references: [id], onDelete: Cascade)
  previousScore    Float?
  newScore         Float?
  previousFeedback String?     @db.Text
  reason           String?
  actorId          String
  actor            User        @relation("GradeRevisionActor", fields: [actorId], references: [id])
  createdAt        DateTime    @default(now())

  @@index([institutionId, gradeEntryId])
  @@map("grade_entry_revisions")
}

// --- S2: identidad global. `User` es la pertenencia de una identidad a una institución. ---

model Identity {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String?
  sessionVersion Int        @default(0)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  users          User[]

  @@map("identities")
}

// --- Curso completo: programas, grupos y clases en vivo ---

model Program {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  isPublished   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  courses       ProgramCourse[]
  groups        StudentGroup[]

  @@unique([institutionId, name])
  @@map("programs")
}

model ProgramCourse {
  institutionId String
  programId     String
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order         Int     @default(0)

  @@id([programId, courseId])
  @@index([institutionId])
  @@map("program_courses")
}

model StudentGroup {
  id            String               @id @default(cuid())
  institutionId String
  institution   Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programId     String?
  program       Program?             @relation(fields: [programId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  startsOn      DateTime             @db.Date
  endsOn        DateTime?            @db.Date
  capacity      Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       StudentGroupMember[]
  courses       StudentGroupCourse[]

  @@unique([institutionId, name])
  @@map("student_groups")
}

model StudentGroupMember {
  institutionId String
  groupId       String
  group         StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime     @default(now())

  @@id([groupId, userId])
  @@index([institutionId, userId])
  @@map("student_group_members")
}

model StudentGroupCourse {
  institutionId String
  groupId       String
  group         StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([groupId, courseId])
  @@index([institutionId])
  @@map("student_group_courses")
}

model LiveClass {
  id              String      @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startsAt        DateTime
  durationMinutes Int         @default(60)
  joinUrl         String
  createdById     String
  createdBy       User        @relation("LiveClassCreator", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([institutionId, startsAt])
  @@index([courseId, startsAt])
  @@map("live_classes")
}

// --- Tanda 3: pagos, notificaciones y venta de cursos ---

model Payment {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  conceptId     String
  concept       PaymentConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  amountCents   Int
  method        String
  paidOn        DateTime       @db.Date
  note          String?
  recordedById  String
  recordedBy    User           @relation("PaymentRecorder", fields: [recordedById], references: [id])
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime       @default(now())

  @@index([institutionId, conceptId])
  @@index([institutionId, paidOn])
  @@map("payments")
}

model Notification {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  body          String?
  href          String?
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId, readAt])
  @@index([institutionId, createdAt])
  @@map("notifications")
}

/// Qué notificaciones quiere recibir cada persona por correo. Sin fila, vale el valor por omisión del tipo.
model NotificationPreference {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  email         Boolean
  updatedAt     DateTime    @updatedAt

  @@unique([userId, kind])
  @@index([institutionId])
  @@map("notification_preferences")
}

model Coupon {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String
  percentOff    Int
  maxUses       Int?
  usedCount     Int           @default(0)
  expiresAt     DateTime?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  orders        CourseOrder[]

  @@unique([institutionId, code])
  @@map("coupons")
}

model CourseOrder {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  amountCents   Int
  currency      String      @default("DOP")
  status        String      @default("PENDING")
  paymentMethod String?
  paymentNote   String?
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, status])
  @@index([courseId, buyerId])
  @@map("course_orders")
}

model CourseReview {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([courseId, userId])
  @@index([institutionId, courseId])
  @@map("course_reviews")
}

// --- Backoffice C ---
// Institution relations: platformSubscription InstitutionSubscription? ; platformInvoices PlatformInvoice[]
enum InstitutionSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}
enum PlatformInvoiceStatus {
  OPEN
  PAID
  VOID
}
model PlatformPlan {
  code Plan @id
  name String
  priceCents Int
  currency String @default("DOP")
  maxStudents Int?
  maxStorageMb Int?
  aiRequestsPerMonth Int?
  features Json @default("{}")
  active Boolean @default(true)
  subscriptions InstitutionSubscription[]
  @@map("platform_plans")
}
model InstitutionSubscription {
  id String @id @default(cuid())
  institutionId String @unique
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  planCode Plan
  plan PlatformPlan @relation(fields: [planCode], references: [code])
  status InstitutionSubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  trialEndsAt DateTime?
  priceCents Int
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, currentPeriodEnd])
  @@map("institution_subscriptions")
}
model PlatformInvoice {
  id String @id @default(cuid())
  institutionId String
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd DateTime
  amountCents Int
  currency String @default("DOP")
  status PlatformInvoiceStatus @default(OPEN)
  dueDate DateTime
  paidAt DateTime?
  paymentMethod String?
  reference String?
  recordedBy String
  provider String?
  providerRef String?
  createdAt DateTime @default(now())
  @@index([institutionId, status])
  @@index([status, dueDate])
  @@map("platform_invoices")
}
