// Edukana — Prisma Schema MVP
// Multitenancy: row-level via institutionId en cada tabla
// DB: PostgreSQL (Supabase free tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── INSTITUCIÓN ──────────────────────────────────────────────

model Institution {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      InstitutionType @default(SCHOOL)
  logoUrl   String?
  domain    String?  @unique
  timezone  String   @default("America/Santo_Domingo")
  language  String   @default("es")
  plan      Plan     @default(FREE)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  academicPeriods AcademicPeriod[]
  courses         Course[]
  announcements   Announcement[]
  admissionLeads  AdmissionLead[]
  paymentConcepts PaymentConcept[]
  events          CalendarEvent[]

  @@map("institutions")
}

enum InstitutionType {
  SCHOOL
  UNIVERSITY
  INSTITUTE
  ACADEMY
  OTHER
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ─── USUARIOS ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  name          String
  email         String
  emailVerified DateTime?
  password      String?
  avatarUrl     String?
  phone         String?
  role          Role      @default(STUDENT)
  status        UserStatus @default(ACTIVE)

  // NextAuth
  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones académicas
  taughtCourses   Course[]        @relation("TeacherCourses")
  enrollments     Enrollment[]
  submissions     Submission[]
  announcements   Announcement[]  @relation("AnnouncementAuthor")

  @@unique([institutionId, email])
  @@map("users")
}

enum Role {
  SUPER_ADMIN   // Solo Cerkana/Edukana internamente
  ADMIN         // Director/administrador de institución
  COORDINATOR   // Coordinador académico
  TEACHER       // Docente
  STUDENT       // Estudiante
  PARENT        // Padre/tutor
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ─── NEXTAUTH ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── GESTIÓN ACADÉMICA ────────────────────────────────────────

model AcademicPeriod {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  name          String   // "2026-I", "Primer trimestre 2026"
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  courses       Course[]
  paymentConcepts PaymentConcept[]

  @@map("academic_periods")
}

model Course {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  periodId      String
  period        AcademicPeriod @relation(fields: [periodId], references: [id])
  teacherId     String
  teacher       User     @relation("TeacherCourses", fields: [teacherId], references: [id])

  name          String
  code          String?
  description   String?
  schedule      Json?    // [{day: "MON", start: "08:00", end: "09:30"}, ...]
  room          String?
  maxStudents   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]
  assignments   Assignment[]
  modules       CourseModule[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int      @default(0)
  content     String?  @db.Text  // Rich text / Markdown
  fileUrls    Json?    // ["url1", "url2"]
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("course_modules")
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])

  status      EnrollmentStatus @default(ACTIVE)
  finalGrade  Float?
  enrolledAt  DateTime @default(now())

  attendances Attendance[]
  submissions Submission[]

  @@unique([studentId, courseId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  FAILED
}

model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  date         DateTime
  classSession String?  // "Clase 1 - Introducción"
  status       AttendanceStatus @default(PRESENT)
  notes        String?
  recordedAt   DateTime @default(now())

  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ─── AULA ─────────────────────────────────────────────────────

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  dueDate     DateTime?
  maxScore    Float    @default(100)
  type        AssignmentType @default(TASK)
  aiGenerated Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@map("assignments")
}

enum AssignmentType {
  TASK      // Tarea
  QUIZ      // Cuestionario
  EXAM      // Examen
  PROJECT   // Proyecto
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User     @relation(fields: [studentId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  content     String?  @db.Text
  fileUrls    Json?    // ["url1", "url2"]
  score       Float?
  feedback    String?  @db.Text
  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime @default(now())
  gradedAt    DateTime?

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

// ─── ADMISIONES ───────────────────────────────────────────────

model AdmissionLead {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  name            String
  email           String
  phone           String?
  programInterest String?
  stage           AdmissionStage @default(INTERESTED)
  documents       Json?    // [{name: "Cédula", url: "...", status: "pending"}]
  notes           String?  @db.Text
  source          String?  // "web", "whatsapp", "referral"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("admission_leads")
}

enum AdmissionStage {
  INTERESTED    // Interesado
  DOCUMENTS     // Enviando documentos
  REVIEW        // En revisión
  ACCEPTED      // Aceptado
  ENROLLED      // Matriculado
  REJECTED      // Rechazado
}

// ─── PAGOS ────────────────────────────────────────────────────

model PaymentConcept {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String?  // null = aplica a grupo/todos
  periodId      String?
  period        AcademicPeriod? @relation(fields: [periodId], references: [id])

  concept       String   // "Matrícula Enero 2026", "Mensualidad Febrero"
  amount        Float
  currency      String   @default("DOP")
  dueDate       DateTime?
  paidAt        DateTime?
  status        PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime @default(now())

  @@map("payment_concepts")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

// ─── COMUNIDAD ────────────────────────────────────────────────

model Announcement {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  title         String
  content       String   @db.Text
  audience      AnnouncementAudience @default(ALL)
  audienceId    String?  // courseId o grupoId si audience != ALL
  isPinned      Boolean  @default(false)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("announcements")
}

enum AnnouncementAudience {
  ALL       // Toda la institución
  COURSE    // Una materia específica
  ROLE      // Un rol (solo docentes, solo estudiantes)
}

model CalendarEvent {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  allDay        Boolean  @default(true)
  color         String?  @default("#2457F5")
  createdAt     DateTime @default(now())

  @@map("calendar_events")
}

// ─── AUDITORÍA ────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String?
  userId        String?

  action        String   // "CREATE", "UPDATE", "DELETE", "LOGIN"
  entity        String   // "User", "Course", "Enrollment"
  entityId      String?
  changes       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}
